<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Description>NexBot engine: Silkroad protocol, pk2/media reader, game database, client loader and proxy.</Description>
    <RootNamespace>NexBot</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexBot.Tests" />
  </ItemGroup>

</Project>
